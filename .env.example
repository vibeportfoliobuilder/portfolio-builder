# .env.example - the credentials pb reads. Copy to .env (never committed) and fill in.
# pb loads .env from the working directory at startup; an exported variable wins.
# `make test` never reads it; `make test-live` sources it.

# Eulerpool: financials, dividends, ETFs, macro, US news (pb ep ...). A free tier exists.
EULERPOOL_API_KEY=

# Tavily web search (pb search, and the cited web fallback for the human view).
TAVILY_API_KEY=

# SEC EDGAR needs no key, only a User-Agent with a contact address (pb edgar).
SEC_USER_AGENT=
